{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D3 option2 S1 result",
  "type": "object",
  "required": ["schema", "stage", "status", "source_sha", "checkpoints", "observations", "not_executed", "elapsed_seconds"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "S1"},
    "status": {"enum": ["PASS", "FAIL", "HOLD"]},
    "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "checkpoints": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "required": ["id", "status", "details"],
        "properties": {
          "id": {"enum": ["S1-V01", "S1-V02", "S1-V03", "S1-V04", "S1-V05"]},
          "status": {"const": "PASS"},
          "details": {"type": "string"}
        }
      }
    },
    "observations": {"type": "object"},
    "not_executed": {"type": "array", "items": {"type": "string"}},
    "elapsed_seconds": {"type": "number", "maximum": 2400}
  }
}

ARG NODE_RUNTIME_IMAGE
FROM ${NODE_RUNTIME_IMAGE}
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --chown=10001:10001 standalone/ ./
COPY --chown=10001:10001 static/ ./.next/static/
COPY --chown=10001:10001 startup.mjs ./startup.mjs
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["/bin/sh", "-ec", "node startup.mjs; exec node server.js"]
ARG D3_FRONTEND_SHA256
LABEL org.koikifw.d3.frontend-sha256=${D3_FRONTEND_SHA256}

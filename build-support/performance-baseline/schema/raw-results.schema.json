{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOIKI CP9 raw performance results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "samples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sampleType", "variant", "workload", "fork", "sequence",
          "durationNanos", "httpStatus", "responseBytes", "success", "errorCode"
        ],
        "properties": {
          "sampleType": { "enum": ["request", "startup"] },
          "variant": { "enum": ["bare", "koiki"] },
          "workload": { "enum": ["http-success", "validation-rejection", "db-write", "startup"] },
          "fork": { "type": "integer", "minimum": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "durationNanos": { "type": "integer", "minimum": 0 },
          "httpStatus": { "type": ["integer", "null"] },
          "responseBytes": { "type": "integer", "minimum": 0 },
          "success": { "type": "boolean" },
          "errorCode": { "type": ["string", "null"] }
        }
      }
    }
  }
}
